      #       data:
      #         value: "{{ value }}"


  # ===========================================================================
  # SELECTS (estados ESS — escritura)
  # ===========================================================================
  - select:

      - name: "ESS BatteryLife State"
        unique_id: ess_batterylife_state
        # Replica las opciones tal cual las expone la entidad Victron
        options: >
          {{ state_attr('select.gx_device_ess_batterylife_state', 'options') | default([], true) }}
        state: "{{ states('select.gx_device_ess_batterylife_state') }}"
        availability: "{{ has_value('select.gx_device_ess_batterylife_state') }}"
        select_option:
          - service: select.select_option
            target:
              entity_id: select.gx_device_ess_batterylife_state
            data:
              option: "{{ option }}"

      # # --- Selects adicionales ---
