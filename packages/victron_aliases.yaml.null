  # ===========================================================================
  # NUMBERS (parámetros ESS — escritura)
  # ===========================================================================
  - number:

      - name: "ESS Max Charge Current"
        unique_id: ess_max_charge_current
        unit_of_measurement: "A"
        min: 0
        max: 100
        step: 1
        state: "{{ states('number.gx_device_ess_max_charge_current') }}"
        availability: "{{ has_value('number.gx_device_ess_max_charge_current') }}"
        set_value:
          - service: number.set_value
            target:
              entity_id: number.gx_device_ess_max_charge_current
            data:
              value: "{{ value }}"

      - name: "ESS Min SoC Limit"
        unique_id: ess_min_soc_limit
        unit_of_measurement: "%"
        min: 0
        max: 100
        step: 1
        state: "{{ states('number.gx_device_ess_min_soc_limit') }}"
        availability: "{{ has_value('number.gx_device_ess_min_soc_limit') }}"
        set_value:
          - service: number.set_value
            target:
              entity_id: number.gx_device_ess_min_soc_limit
            data:
              value: "{{ value }}"

      # # --- ESS Numbers adicionales ---
