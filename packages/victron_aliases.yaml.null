# =============================================================================
# Package: victron_aliases.yaml
# -----------------------------------------------------------------------------
# Capa de abstracción sobre las entidades de la integración Victron.
# Usa SIEMPRE los entity_id de este fichero en automatizaciones, scripts,
# dashboards, recorder, etc. Si un día cambias hardware o las entidades de
# abajo mutan (p.ej. añaden _2), solo tocas este archivo.
#
# Activos: ~15 alias principales. El resto está comentado para activar bajo
# demanda. Descomenta el bloque entero (name + unique_id + state + ...) y
# recarga "Template entities" o reinicia HA.
#
# Convención de naming:
#   number.ess_*                →  parámetros ESS escribibles
#   select.ess_*                →  estados ESS escribibles
# =============================================================================

template:

  # ===========================================================================
  # SENSORES (solo lectura)
  # ===========================================================================
  - sensor:

      # -----------------------------------------------------------------------
      # BATERÍA (Basen)
      # -----------------------------------------------------------------------

      - name: "Batería SoC"
        unique_id: bateria_soc
        unit_of_measurement: "%"
        device_class: battery
        state_class: measurement
        state: "{{ states('sensor.bateria_basen_charge') }}"
        availability: "{{ has_value('sensor.bateria_basen_charge') }}"

      - name: "Batería Potencia"
        unique_id: bateria_potencia
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        # Convención: positivo = cargando, negativo = descargando
        state: "{{ states('sensor.bateria_basen_power') }}"
        availability: "{{ has_value('sensor.bateria_basen_power') }}"

      - name: "Batería Tensión"
        unique_id: bateria_tension
        unit_of_measurement: "V"
        device_class: voltage
        state_class: measurement
        state: "{{ states('sensor.bateria_basen_dc_bus_voltage') }}"
        availability: "{{ has_value('sensor.bateria_basen_dc_bus_voltage') }}"

      - name: "Batería Temperatura"
        unique_id: bateria_temperatura
        unit_of_measurement: "°C"
        device_class: temperature
        state_class: measurement
        state: "{{ states('sensor.bateria_basen_temperatura') }}"
        availability: "{{ has_value('sensor.bateria_basen_temperatura') }}"

      - name: "Batería SoH"
        unique_id: bateria_soh
        unit_of_measurement: "%"
        state_class: measurement
        state: "{{ states('sensor.bateria_basen_state_of_health') }}"
        availability: "{{ has_value('sensor.bateria_basen_state_of_health') }}"

      # -----------------------------------------------------------------------
      # SOLAR
      # -----------------------------------------------------------------------

      - name: "Solar Potencia Total"
        unique_id: solar_potencia_total
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        # Suma MPPT (DC) + Sunnyboy (AC). Recuerda: medidos en puntos
        # distintos (DC vs AC), de ahí el ~7,5% de discrepancia sistemática.
        state: >
          {{ (states('sensor.gx_device_pv_power')|float(0) + states('sensor.sma_sunnyboy_5_power_total')|float(0)) | round(0) }}
        availability: >
          {{ has_value('sensor.gx_device_pv_power') and has_value('sensor.sma_sunnyboy_5_power_total') }}

      - name: "Solar MPPT Potencia"
        unique_id: solar_mppt_potencia
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: "{{ states('sensor.gx_device_pv_power') }}"
        availability: "{{ has_value('sensor.gx_device_pv_power') }}"

      - name: "Solar Sunnyboy Potencia"
        unique_id: solar_sunnyboy_potencia
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: "{{ states('sensor.sma_sunnyboy_5_power_total') }}"
        availability: "{{ has_value('sensor.sma_sunnyboy_5_power_total') }}"

      - name: "Solar Generación Hoy"
        unique_id: solar_generacion_hoy
        unit_of_measurement: "kWh"
        device_class: energy
        state_class: total_increasing
        state: "{{ states('sensor.generacion_solar_diaria') }}"
        availability: "{{ has_value('sensor.generacion_solar_diaria') }}"

      # -----------------------------------------------------------------------
      # RED ELÉCTRICA Y CONSUMO
      # -----------------------------------------------------------------------

      - name: "Red Potencia"
        unique_id: red_potencia
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        # Positivo = consumiendo de red, negativo = inyectando
        state: "{{ states('sensor.gx_device_grid_power_l1') }}"
        availability: "{{ has_value('sensor.gx_device_grid_power_l1') }}"

      - name: "Consumo Casa"
        unique_id: consumo_casa
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: "{{ states('sensor.gx_device_consumption_power_l1') }}"
        availability: "{{ has_value('sensor.gx_device_consumption_power_l1') }}"

      # -----------------------------------------------------------------------
      # INVERSOR / SISTEMA
      # -----------------------------------------------------------------------

      - name: "Inversor Potencia Salida"
        unique_id: inversor_potencia_salida
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: "{{ states('sensor.multiplus_ii_48_5000_70_50_id_276_output_power_l1') }}"
        availability: "{{ has_value('sensor.multiplus_ii_48_5000_70_50_id_276_output_power_l1') }}"

      - name: "Sistema Estado"
        unique_id: sistema_estado
        state: "{{ states('sensor.gx_device_system_state') }}"
        availability: "{{ has_value('sensor.gx_device_system_state') }}"


      # =====================================================================
      # ====== SENSORES ADICIONALES (comentados, descomentar a demanda) =====
      # =====================================================================

      # # --- Batería avanzado ---
